generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  GYM_OWNER
  GYM_STAFF
  TRAINER
  MEMBER
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  name          String?
  role          RoleName       @default(MEMBER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  // relations
  gymsOwned     Gym[]          @relation("GymOwner")
  reviews       Review[]
  trainer       Trainer?
  member        Member?
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  @@index([email])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  // optional device info
  deviceInfo String?
}

model Gym {
  id             Int                @id @default(autoincrement())
  name           String
  slug           String             @unique
  description    String?
  ownerId        Int
  owner          User               @relation("GymOwner", fields: [ownerId], references: [id])
  address        String?
  city           String?
  state          String?
  country        String?
  latitude       Float?
  longitude      Float?
  verified       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // placeholder relations
  facilities     GymFacility[]
  images         GymImage[]
  videos         GymVideo[]
  operatingHours GymOperatingHour[]
  offers         Offer[]
  reviews        Review[]
  enquiries      Enquiry[]

  trainers        Trainer[]
  members         Member[]
  membershipPlans MembershipPlan[]
  attendances     Attendance[]
  workoutPlans    WorkoutPlan[]

  @@index([slug])
  @@index([latitude, longitude])
  @@index([ownerId])
}

model GymFacility {
  id    Int    @id @default(autoincrement())
  gymId Int
  gym   Gym    @relation(fields: [gymId], references: [id])
  name  String

  @@index([gymId])
}

model GymImage {
  id      Int     @id @default(autoincrement())
  gymId   Int
  gym     Gym     @relation(fields: [gymId], references: [id])
  url     String
  altText String?

  @@index([gymId])
}

model GymVideo {
  id    Int     @id @default(autoincrement())
  gymId Int
  gym   Gym     @relation(fields: [gymId], references: [id])
  url   String
  title String?

  @@index([gymId])
}

model GymOperatingHour {
  id        Int    @id @default(autoincrement())
  gymId     Int
  gym       Gym    @relation(fields: [gymId], references: [id])
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  openTime  String // e.g. "08:00"
  closeTime String // e.g. "22:00"

  @@index([gymId])
}

model Offer {
  id          Int      @id @default(autoincrement())
  gymId       Int
  gym         Gym      @relation(fields: [gymId], references: [id])
  title       String
  description String?
  discount    Float // percent or amount
  startDate   DateTime
  endDate     DateTime
  active      Boolean  @default(true)

  @@index([gymId])
  @@index([active])
}

model Review {
  id        Int      @id @default(autoincrement())
  gymId     Int
  gym       Gym      @relation(fields: [gymId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  moderated Boolean  @default(false)

  @@index([gymId])
  @@index([userId])
}

model Enquiry {
  id        Int      @id @default(autoincrement())
  gymId     Int
  gym       Gym      @relation(fields: [gymId], references: [id])
  name      String
  email     String
  phone     String?
  message   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  source    String?

  @@index([gymId])
  @@index([status])
}

// Additional models (MembershipPlan, Membership, Payment, Attendance, WorkoutPlan, etc.) can be added later.

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
}

model Trainer {
  id       Int           @id @default(autoincrement())
  userId   Int           @unique
  user     User          @relation(fields: [userId], references: [id])
  gymId    Int
  gym      Gym           @relation(fields: [gymId], references: [id])
  // additional trainer fields
  workouts WorkoutPlan[]
}

model Member {
  id           Int              @id @default(autoincrement())
  userId       Int              @unique
  user         User             @relation(fields: [userId], references: [id])
  gymId        Int
  gym          Gym              @relation(fields: [gymId], references: [id])
  memberships  Membership[]
  attendances  Attendance[]
  progress     ProgressRecord[]
  workoutPlans WorkoutPlan[]    @relation("MemberWorkoutPlans")
}

model MembershipPlan {
  id             Int          @id @default(autoincrement())
  gymId          Int
  gym            Gym          @relation(fields: [gymId], references: [id])
  name           String
  description    String?
  price          Float
  durationMonths Int
  active         Boolean      @default(true)
  memberships    Membership[]
}

model Membership {
  id        Int              @id @default(autoincrement())
  memberId  Int
  member    Member           @relation(fields: [memberId], references: [id])
  planId    Int
  plan      MembershipPlan   @relation(fields: [planId], references: [id])
  startDate DateTime         @default(now())
  endDate   DateTime?
  status    MembershipStatus @default(PENDING)
}

model Attendance {
  id       Int              @id @default(autoincrement())
  memberId Int
  member   Member           @relation(fields: [memberId], references: [id])
  gymId    Int
  gym      Gym              @relation(fields: [gymId], references: [id])
  checkIn  DateTime         @default(now())
  checkOut DateTime?
  status   AttendanceStatus @default(CHECKED_IN)
}

model ProgressRecord {
  id         Int      @id @default(autoincrement())
  memberId   Int
  member     Member   @relation(fields: [memberId], references: [id])
  date       DateTime @default(now())
  notes      String?
  weightKg   Float?
  bodyFatPct Float?
}

model WorkoutPlan {
  id          Int      @id @default(autoincrement())
  gymId       Int
  gym         Gym      @relation(fields: [gymId], references: [id])
  trainerId   Int?
  trainer     Trainer? @relation(fields: [trainerId], references: [id])
  name        String
  description String?
  // additional fields like exercises can be related later
  members     Member[] @relation("MemberWorkoutPlans")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  Int?
  details   String?
  createdAt DateTime @default(now())
}

