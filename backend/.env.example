# .env.example
# Copy this file to .env and fill in real values

# Server configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
# PostgreSQL connection string. Example:
# postgres://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/gymos?schema=public

# JWT secrets (use strong random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Token expiry times (e.g., 15m, 7d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting (values in milliseconds / counts)
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=1000           # general limit per IP
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_FORGOT_WINDOW_MS=3600000
RATE_LIMIT_FORGOT_MAX=5
